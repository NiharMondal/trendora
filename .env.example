# Trendora frontend — copy to .env.local and fill in.
#   cp .env.example .env.local
#
# Every value below is REQUIRED. src/shared/config/env-config.ts (public) and
# server-env.ts (secrets) validate them at build and at page load, and fail
# naming the variable — a missing tax rate used to quote 0% silently (FE-30).

# --- Public (inlined into the browser bundle — never put a secret here) -----

# Backend API base. Must include /api/v1. The backend's CORS allows only
# http://localhost:3000, so serve the frontend on port 3000 in development.
NEXT_PUBLIC_BACKEND_URL=http://localhost:5001/api/v1

# Must equal the backend's TAX_RATE. A fraction: 0.05 is 5%.
NEXT_PUBLIC_TAX_RATE=0.05

# Fallbacks ONLY. Shipping is charged per store from each cart item; these apply
# just to a cart persisted before stores existed. Keep them equal to the
# backend's SHIPPING_COST / FREE_SHIPPING_THRESHOLD.
NEXT_PUBLIC_SHIPPING_COST=100
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=1000

# Cloudinary unsigned upload (the browser uploads directly; see CLAUDE.md →
# Image uploads). The preset must put uploads in trendora/temp/<folder>.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_PRESET_NAME=your-unsigned-preset

# --- Server only ------------------------------------------------------------

# NextAuth. Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXT_AUTH_SECRET=replace-with-a-long-random-string

# Google OAuth (https://console.cloud.google.com/apis/credentials).
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
